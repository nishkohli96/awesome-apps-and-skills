# Mixpanel project token (Mixpanel > Settings > Project settings). Leave empty to turn tracking off.
NEXT_PUBLIC_MIXPANEL_TOKEN=
# Only for EU-hosted projects: https://api-eu.mixpanel.com (the US default needs no value).
NEXT_PUBLIC_MIXPANEL_API_HOST=

# Public origin of the site (sitemap, metadata, and the only host analytics records once set).
NEXT_PUBLIC_SITE_URL=
